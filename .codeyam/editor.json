{
  "$comment": "Per-developer settings (port, provider, proxy ports, startCommand, etc.) belong in editor.local.json. That file is gitignored and is deep-merged on top of this one at load time. Changing `provider` after scaffold does NOT install that agent's surface \u2014 re-run `codeyam-editor editor install-hooks` (or `codeyam-editor init --provider <name>`) to install it. See CLAUDE.md or run `codeyam-editor editor config-show` to inspect the effective config.",
  "apps": [
    {
      "dir": "site",
      "framework": "plain-html",
      "name": "site",
      "port": 4780,
      "startCommand": "sh ../scripts/build-site.sh && python3 -m http.server 4781 --bind 127.0.0.1",
      "type": "web"
    }
  ],
  "audit": {
    "allowedDocumentationOnlySlugs": [
      "post-merge-drift-sweep"
    ],
    "branchBaseRef": "main",
    "coverageBootstrap": {
      "enabled": true
    },
    "glossarySkip": [
      {
        "filePath": "crates/simbiguity-circuits/src/mna_tests.rs",
        "name": "battery_and_resistor",
        "reason": "test-fixture"
      }
    ],
    "itemShape": {
      "changeWithoutVerify": "note",
      "compound": "warning",
      "vague": "warning"
    },
    "scenarioFreshnessDays": 14,
    "sharedBaselineMinScenarios": 10,
    "sizeBudget": {
      "maxEntityLines": 150,
      "maxFileLines": 500,
      "severity": "warning"
    },
    "stepBudget": {
      "maxChecklistItems": 6,
      "maxLines": 80,
      "severity": "warning"
    },
    "suppressions": {
      "ratchet": true,
      "severity": "warning"
    },
    "testNamingConventions": {}
  },
  "catalogAutoAdd": {
    "allow": [],
    "deny": []
  },
  "cleanup": {
    "completedPlanMinAgeDays": 90,
    "completedPlanRetention": 500,
    "logCompress": true,
    "logDeleteDays": 30,
    "logRotateDays": 7,
    "screenshotPruneOrphans": true,
    "tmpDeleteHours": 24
  },
  "coverageThresholds": {
    "global": {
      "minLinePercent": 90.0
    }
  },
  "crossTargetChecks": [
    {
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "container": {
        "cacheDirs": [
          "target",
          "/usr/local/cargo/registry"
        ],
        "image": "rust:1-bookworm",
        "setup": "rustup component add clippy"
      },
      "name": "linux-clippy"
    }
  ],
  "database": null,
  "deviceScaleFactor": 2.0,
  "env": {},
  "files": {
    "eventLogMaxBytes": null,
    "journalShardEntries": null,
    "logKeepRotated": null,
    "textLogMaxBytes": null
