      "maxProgressStallSec": 900,
      "pollIntervalMs": 2000,
      "rehearseAtPosition": 2,
      "serverHeartbeatIntervalSec": 60,
      "stallEscalationSec": 1800,
      "surfaceWaitAfterSec": 1800,
      "waitTimeoutSec": 300,
      "yieldOnQuestionSec": 600
    },
    "planClaims": {
      "enabled": true,
      "fetchIntervalSec": 3,
      "livenessIntervalSec": 120
    }
  },
  "hooks": {},
  "port": 4781,
  "projectDescription": "An open source simulation engine by The Ambiguity Project. Zero-dependency Rust crates for simulation (circuits, physics, markets), animation and 3D rendering, embedded in static HTML demos via a hand-written WASM interface and a from-scratch WebGL2 renderer.",
